# Entorno de desarrollo local con Hot Module Replacement (HMR)
# Para activar: cp docker-compose.override.yml.example docker-compose.override.yml && docker compose up -d
services:
  webapp:
    build:
      context: ./Discordia-WebApp
      dockerfile: Dockerfile.dev
    # !override reemplaza el puerto 5173:80 de producción para usar 5173:5173 en desarrollo sin colisión
    ports: !override
      - "5173:5173"
    volumes:
      - ./Discordia-WebApp:/app
      - /app/node_modules
    environment:
      - VITE_API_URL=http://localhost:8000
      - VITE_WS_URL=ws://localhost:3000
    # En desarrollo corre Vite (puerto 5173), desactivamos el healthcheck de Nginx (puerto 80)
    healthcheck:
      disable: true

  auth-service:
    # Igual al CMD del Dockerfile, más --reload: uvicorn reinicia al detectar cambios en el código montado.
    command: sh -c "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"
    volumes:
      - ./Auth-User-Service:/app
