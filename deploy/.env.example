# Copiar a deploy/.env (en .gitignore). Docker Compose lo lee solo.
#
# ---------- Local: los tres nodos en tu máquina ----------
# Con esto alcanza: los nodos se hablan por host.docker.internal (la "IP" de tu máquina vista desde los
# contenedores) y los secretos usan los defaults de desarrollo del compose, salvo los de abajo.
COMPOSE_PROFILES=edge,realtime,infra,local
# Solo desarrollo. El compose no les da default: en un nodo sin estas líneas, RabbitMQ y LiveKit no arrancan
# en vez de quedar con estas claves.
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_min_32_chars_long
# Estado de la plataforma (Notification sondea los /readyz a través de Kong). Sin esto, "Sin datos".
STATUS_GATEWAY_URL=https://host.docker.internal:8443
# Solo para probar la app mobile en un teléfono (Expo Go): publica el HTTP de Kong (8000) en la red local, no
# solo en localhost. La app le pega a la IP de esta máquina. Exponerlo en una red pública es exponer la API
# sin TLS: dejarlo comentado si no se usa, y nunca en producción.
# GATEWAY_HTTP_BIND=0.0.0.0

# ---------- Producción: una EC2 por nodo ----------
# En cada EC2, /etc/discordia/nodes.env (permisos 600) con:
#   COMPOSE_PROFILES=<edge | realtime | infra>   (solo el nodo de esa máquina)
#
#   Imágenes publicadas por el CI de cada repo en GHCR. Un tag por servicio: el SHA del commit de su repo
#   (también sirve el nombre de la rama, p. ej. develop, para pruebas):
#   REGISTRY=ghcr.io/discordia-g12
#   edge:     GATEWAY_TAG, AUTH_SERVICE_TAG, SERVER_ROLES_TAG
#   realtime: CHAT_ENGINE_TAG, VOICE_SIGNALING_TAG, NOTIFICATION_TAG
#   infra:    PAYMENTS_TAG
#
#   IPs privadas de los otros nodos (terraform output nodes):
#   EDGE_HOST=10.0.1.10
#   REALTIME_HOST=10.0.1.20
#   INFRA_HOST=10.0.1.30
#
#   Base de datos: el RDS (terraform output rds_endpoint), igual en los tres nodos. Una sola instancia con
#   una base por servicio (auth_db, server_roles_db, notification_db, payments_db):
#   DB_HOST=<endpoint del RDS>
#   DB_USER=discordia_admin
#   DB_PASSWORD=<contraseña maestra del RDS>
#   realtime: NOTIFICATION_DB_SSLMODE=no-verify   (el RDS exige TLS; Node no trae la CA de Amazon)
#
#   Secretos propios: generarlos con `openssl rand -hex 32` (solo letras y números). NO usar -base64:
#   sus / + = rompen las URLs donde van algunas contraseñas (RabbitMQ del chat, base de Notification
#   y Payments). Lo mismo vale para DB_PASSWORD. Los de RabbitMQ, iguales en los tres nodos:
#   RABBITMQ_USER / RABBITMQ_PASSWORD
#   edge:     GATEWAY_HTTPS_PORT=443
#             KONG_STATUS_BIND=0.0.0.0   (métricas de Kong en 8100 para Prometheus; el SG solo lo abre a infra)
#             S3_BUCKET / S3_PUBLIC_BASE_URL (terraform output media_bucket) y las claves de cada servicio
#             (terraform output media_access_key_commands): AUTH_AWS_ACCESS_KEY_ID / AUTH_AWS_SECRET_ACCESS_KEY,
#             SERVER_ROLES_AWS_ACCESS_KEY_ID / SERVER_ROLES_AWS_SECRET_ACCESS_KEY. Van en el nodo donde corra
#             cada servicio: si uno se mueve de nodo, sus claves se mueven con él.
#             AUTH0_MGMT_CLIENT_ID / AUTH0_MGMT_CLIENT_SECRET: aplicación Machine to Machine de Auth0 (read:users,
#             update:users) para suspender usuarios desde el backoffice. Sin ellas, suspender responde 503.
#             SUSPENSION_DENYLIST_TTL_SECONDS (opcional): vida del access token de la API de Auth0, si se acorta
#   realtime: STATUS_GATEWAY_URL=https://10.0.1.10:443   (Kong en edge, para el estado de la plataforma). Agregarlo
#             recién con la regla de SG realtime→edge 443 aplicada y el Gateway con /internal/readyz/* desplegado:
#             antes, el estado público mostraría una caída falsa
#             LIVEKIT_API_KEY, LIVEKIT_API_SECRET (32+ caracteres),
#             MONGO_URI (Atlas), LIVEKIT_NODE_IP (Elastic IP), LIVEKIT_PUBLIC_URL=wss://api.discordia.lol/livekit
#   infra:    GRAFANA_ADMIN_PASSWORD
#
# y se levanta con (sin construir nada en el servidor):
#   docker compose -f /opt/discordia/deploy/docker-compose.yml --env-file /etc/discordia/nodes.env pull
#   docker compose -f /opt/discordia/deploy/docker-compose.yml --env-file /etc/discordia/nodes.env up -d --no-build
