# Solo producción (nodo edge): copiar a deploy/gateway.env.

# TLS entre Cloudflare y Kong: Cloudflare Origin Certificate (SSL/TLS → Origin Server en el dashboard).
# Los archivos van en TLS_DIR (por defecto deploy/tls/, en .gitignore).
KONG_SSL_CERT=/etc/kong/tls/origin.pem
KONG_SSL_CERT_KEY=/etc/kong/tls/origin.key

# Detrás de Cloudflare todas las conexiones llegan desde IPs de Cloudflare: sin esto, el rate limiting
# trataría a todos los usuarios como una sola IP. Valor: `terraform output -raw cloudflare_trusted_ips`.
KONG_TRUSTED_IPS=<rangos de Cloudflare separados por coma>
KONG_REAL_IP_HEADER=CF-Connecting-IP
KONG_REAL_IP_RECURSIVE=on
