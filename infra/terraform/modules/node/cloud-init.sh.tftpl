#!/bin/bash
# Arranque del nodo ${node_name}: corre una sola vez, en el primer boot.
set -euo pipefail

COMPOSE_VERSION="v2.29.7"

# Swap de 2 GB: margen ante picos de memoria en los 2 GB de la t3.small
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# Docker + plugin de Compose (AL2023 no lo trae empaquetado; versión fija para que todos los nodos sean iguales)
dnf install -y docker git
mkdir -p /usr/libexec/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/$${COMPOSE_VERSION}/docker-compose-linux-x86_64" \
  -o /usr/libexec/docker/cli-plugins/docker-compose
chmod +x /usr/libexec/docker/cli-plugins/docker-compose

# Rotación de logs: sin esto los logs de los contenedores llenan el disco
mkdir -p /etc/docker
cat > /etc/docker/daemon.json <<'JSON'
{
  "log-driver": "json-file",
  "log-opts": { "max-size": "10m", "max-file": "3" }
}
JSON

systemctl enable --now docker
usermod -aG docker ec2-user


# Carpeta de despliegue: compose del nodo y archivos .env con secretos (solo root)
install -d -m 0755 /opt/discordia
install -d -m 0700 /etc/discordia

echo "${node_name}" > /etc/discordia/node-name
