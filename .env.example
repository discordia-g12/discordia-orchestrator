# Archivo .env para entorno de deploy

VITE_API_URL=http://ec2-3-239-116-240.compute-1.amazonaws.com:8000
VITE_WS_URL=http://ec2-3-239-116-240.compute-1.amazonaws.com:8000

# --- LiveKit (voz) ---
# Opcionales: si no se definen, docker-compose.yml usa los defaults de desarrollo local.
# Credenciales compartidas entre el servidor LiveKit y voice-signaling-service.
# Se recomienda un secret largo (32+ caracteres, p. ej. `openssl rand -base64 32`). Cambiarlas en cualquier ambiente no local.
LIVEKIT_API_KEY=APIr92evGi8gy9y
LIVEKIT_API_SECRET=6o1L5tF2e85msMhSNrKjFNBxi7M2zVAbsggTVeIh3sE

# IP que LiveKit anuncia a los clientes para la media WebRTC.
# Local: 127.0.0.1. Deploy (EC2, etc.): la IP pública del host.
LIVEKIT_NODE_IP=127.0.0.1

# URL de LiveKit que el voice-service le devuelve al cliente junto con el token.
# Local: ws://localhost:7880. Deploy: wss://<dominio> (el micrófono requiere HTTPS fuera de localhost).
LIVEKIT_PUBLIC_URL=ws://localhost:7880
