# Copiar a .env para desarrollo local (docker-compose.yml de la raíz). Sin valores reales: los secretos no
# se commitean. Producción usa /etc/discordia/nodes.env en cada nodo (ver deploy/.env.example).

VITE_API_URL=http://localhost:8000
VITE_WS_URL=http://localhost:8000

RDS_HOST=discordia-db-cluster.cs5mq2qqoey9.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_USER=discordia_admin
RDS_PASSWORD=

# --- Suspensión de usuarios (backoffice) ---
# Aplicación Machine to Machine de Auth0 (read:users, update:users). Sin ella, suspender responde 503.
AUTH0_MGMT_CLIENT_ID=
AUTH0_MGMT_CLIENT_SECRET=

# --- LiveKit (voz) ---
# Opcionales: si no se definen, docker-compose.yml usa los defaults de desarrollo local.
# Credenciales compartidas entre el servidor LiveKit y voice-signaling-service.
# Se recomienda un secret largo (32+ caracteres, p. ej. `openssl rand -base64 32`). Cambiarlas en cualquier ambiente no local.
# LIVEKIT_API_KEY=<api key>
# LIVEKIT_API_SECRET=<openssl rand -base64 32>

# IP que LiveKit anuncia a los clientes para la media WebRTC.
# Local: 127.0.0.1. Deploy (EC2, etc.): la IP pública del host.
LIVEKIT_NODE_IP=127.0.0.1

# URL de LiveKit que el voice-service le devuelve al cliente junto con el token.
# Local: ws://localhost:7880. Deploy: wss://<dominio> (el micrófono requiere HTTPS fuera de localhost).
LIVEKIT_PUBLIC_URL=ws://localhost:7880
